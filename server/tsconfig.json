{
  "compilerOptions": {
    "target": "ES2020", // Target JavaScript version
    "module": "ESNext", // Use ES modules
    "moduleResolution": "NodeNext", // Use Node.js module resolution
    "esModuleInterop": true, // Enable ES module interop
    "skipLibCheck": true, // Skip library checks
    "forceConsistentCasingInFileNames": true, // Ensure consistent file naming
    "outDir": "./dist", // Output directory for compiled JS files
    "rootDir": "./src" // Source directory for TS files
  },
  "include": ["src/**/*"], // Include all files in the src directory
  "exclude": ["node_modules"] // Exclude node_modules
}
